{
    "tabWidth": 2,
    "printWidth": 120,
    "singleQuote": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "parser": "json"
            }
        },
        {
            "files": "package.json|package-lock.json",
            "options": {
                "printWidth": 40
            }
        },
        {
            "files": "*.md",
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
